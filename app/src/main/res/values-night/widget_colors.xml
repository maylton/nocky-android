    <color name="widget_on_primary_container">#EEE8FF</color>

    <!-- Nocky rose-violet tertiary container for secondary widget actions. -->
    <color name="widget_tertiary_container">#6B405D</color>
    <color name="widget_on_tertiary_container">#FFD7EF</color>

    <!-- Play button colors (Low style) -->
    <color name="widget_play_button_low_bg">@color/widget_primary_container</color>
    <color name="widget_play_button_low_icon">@color/widget_on_primary_container</color>
    <color name="widget_play_button_low_stroke">#668B7CFF</color>

    <!-- Music Recognizer Widget colors (Dark) -->
    <!-- Active mic button background – lighter Nocky accent for dark theme -->
    <color name="widget_mic_active_bg">#AFA4FF</color>
    <!-- Pulse ring colors (opacity variants for outward ripple animation) -->
    <color name="widget_mic_pulse_ring">#99EEE8FF</color>
    <color name="widget_mic_pulse_ring_mid">#66EEE8FF</color>
    <color name="widget_mic_pulse_ring_low">#33EEE8FF</color>
